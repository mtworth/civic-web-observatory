# MotherDuck (hosted DuckDB) — get token at app.motherduck.com
# When set, both the crawler and API server use MotherDuck instead of a local file.
MOTHERDUCK_TOKEN=

# Local DuckDB fallback path (used when MOTHERDUCK_TOKEN is not set)
PWO_DB_PATH=outputs/observations.duckdb

# Cloudflare R2 — used by pwo/extract_990_domains.py to read IRS 990 filings
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
